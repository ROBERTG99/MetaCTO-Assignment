            "type": "string",
            "title": "Title"
          },
          "problem": {
            "type": "string",
            "title": "Problem"
          },
          "persona": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Persona"
          },
          "product_area": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Area"
          },
          "status": {
            "$ref": "#/components/schemas/NeedStatus"
          },
          "priority_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
